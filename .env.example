# OAuth bearer from HH (do not commit .env)
HH_ACCESS_TOKEN=

# Required by api.hh.ru — app name + contact email
HH_USER_AGENT=job-search-php/0.1 (you@example.com)

# Local split-tunnel proxy (empty = direct). Browser: socks5:// also ok.
HH_PROXY=socks5h://127.0.0.1:2080

# Playwright Chromium for HH UI (1=headless smoke; login-скрипт сам открывает окно)
HH_BROWSER_HEADLESS=1

# Cookies после php bin/hh.php login (не коммитить)
HH_STORAGE_STATE=data/hh_storage_state.json
HH_LOGIN_TIMEOUT_SEC=300

# Опционально автозаполнение формы (капчу всё равно можете пройти руками)
# HH_LOGIN=
# HH_PASSWORD=

# job_search_ref Core (ingest вакансий в Postgres)
CORE_API_URL=http://127.0.0.1:18000

# Статистика UI → Grafana (пусто = дефолт локальный дашборд)
# GRAFANA_STATS_URL=http://127.0.0.1:3000/d/job-search-2/poisk-raboty?orgId=1&refresh=30s

# DevAI (оценка вакансий из этого репо: config/scoring/prompts)
DEVAI_BASE_URL=http://127.0.0.1:8190
DEVAI_ROUTER_KEY=
DEVAI_MODEL=devai/auto
DEVAI_TIMEOUT_SEC=180

# Устарело: Python scoring job_search_ref больше не в потоке ScoreTen
# SCORING_API_URL=http://127.0.0.1:8090

# Капча HH: авто через 2captcha/rucaptcha (ImageToText), иначе TG DM.
# TWOCAPTCHA_API_KEY=
# RUCAPTCHA_API_KEY=          # алиас; при только нём — host rucaptcha.com
# HH_CAPTCHA_AUTO=1
# HH_CAPTCHA_AUTO_TIMEOUT_S=120
# HH_CAPTCHA_AUTO_ATTEMPTS=4
# TELEGRAM_DM_BOT_TOKEN=
# TELEGRAM_DM_CHAT_ID=
# HH_CAPTCHA_TG=1
# HH_CAPTCHA_TG_TIMEOUT_S=600
# HH_SCREENING_TG=1
# HH_SCREENING_TG_TIMEOUT_S=900
# HH_LETTER_TG=1
# HH_LETTER_TG_TIMEOUT_S=900
